{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ServiceForgeS3BucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::serviceforge-ai-attachments-*",
        "arn:aws:s3:::serviceforge-ai-attachments-*/*"
      ]
    }
  ]
}
