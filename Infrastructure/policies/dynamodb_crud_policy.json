{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ServiceForgeDynamoDBTableAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-south-1:*:table/ServiceForge*",
        "arn:aws:dynamodb:ap-south-1:*:table/ServiceForge*/index/*"
      ]
    }
  ]
}
