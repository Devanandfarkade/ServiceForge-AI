# ServiceForge AI — Frontend Environment Variables
# Copy this file to .env and fill in the values for local development.
# .env is git-ignored. Never commit real credentials.

# AWS Region
VITE_AWS_REGION=ap-south-1

# Amazon Cognito
VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# API Gateway Base URL (no trailing slash)
VITE_API_BASE_URL=https://XXXXXXXXXX.execute-api.ap-south-1.amazonaws.com/prod
