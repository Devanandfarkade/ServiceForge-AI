# ServiceForge AI — Environment Configuration Template
# IMPORTANT: Never commit actual secret keys or credentials to source control.

# Environment Stage & AWS Region
ENVIRONMENT=dev
AWS_REGION=ap-south-1

# Amazon Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Amazon DynamoDB Configuration
DYNAMODB_TABLE_NAME=ServiceForge

# Amazon S3 Bucket Configuration
S3_BUCKET_NAME=serviceforge-ai-attachments-ap-south-1

# Amazon Cognito Authentication
COGNITO_USER_POOL_ID=ap-south-1_example
COGNITO_APP_CLIENT_ID=exampleclientid12345

# Application Logging Level
LOG_LEVEL=INFO

